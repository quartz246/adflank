# Copy to .env.local for local dev. Never commit real values.
# Z.ai key for GLM (OpenAI-compatible). ZAI_API_KEY is accepted as an alias.
GLM_API_KEY=
# Optional. Default: Z.ai coding-plan endpoint https://api.z.ai/api/coding/paas/v4
LLM_BASE_URL=
# Model: glm-5.3-flash by default; on Z.ai 1113 (no balance), 429/1305 (overload) or 5xx AdFlank falls back
# through LLM_FALLBACK_MODELS (default glm-4.7-flash,glm-4.5-flash) and shows the model that actually ran.
LLM_MODEL=glm-5.3-flash
LLM_FALLBACK_MODELS=
# Qloo hackathon key (the harness talks to https://hackathon.api.qloo.com by default).
QLOO_API_KEY=
# Optional: "mock" uses synthetic Qloo data / a deterministic mock LLM (no keys needed).
QLOO_MODE=
LLM_MODE=
# SQLite file (a Docker named volume in production).
DB_PATH=./data/adflank.db
# 0 disables the daily scheduler / the one-click judge demo account.
SCHEDULER=1
DEMO=1
# Abuse limits (defaults shown).
RUN_LIMIT_PER_USER_DAY=6
RUN_LIMIT_PER_IP_DAY=10
RUN_LIMIT_DEMO_DAY=12
CHAT_LIMIT_PER_USER_HOUR=40
SIGNUP_LIMIT_PER_IP_HOUR=10
